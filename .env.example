# Sécurité & Sessions
# Générer avec : openssl rand -base64 32
NUXT_APP_SECRET=00000000000000000000000000000000
# Doit rester identique tant que des données v1 existent (32 caractères minimum).
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=00000000000000000000000000000000

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# --- Rate-limiting & Proxy ---
# N'activer QUE derrière un reverse proxy de confiance (nginx/Traefik)
# qui strip le X-Forwarded-For entrant. Sinon laisser à false.
TRUST_PROXY_HEADERS=false
# Proxies privés de confiance autorisés à transmettre CF-Connecting-IP.
# Exemple : passerelle Cloudflare privée 10.20.0.2/32.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# --- Exposition HTTP ---
# 127.0.0.1 derrière un reverse proxy local.
# 0.0.0.0 si Cloudflare atteint directement l'IP publique du serveur
# (restreindre alors le port 3000 aux plages d'IP Cloudflare).
AIRGAP_BIND_ADDR=127.0.0.1

GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

# --- Service IA externe ---
# true par défaut : les libellés de transactions sont envoyés au service configuré.
# Mettre false pour désactiver toute sortie réseau vers l'IA.
AI_ENABLED=true
AIRGAP_AI_PREDICT_URL=https://airgap-ai.aldwin-weber.fr/predire

# --- Configuration de la Base de Données ---
DB_USER=airgap
DB_PASSWORD=airgap123
DB_NAME=airgap_db

# Cette URL sera utilisée par ton terminal local (ex: npx drizzle-kit push)
NUXT_DATABASE_URL="postgresql://airgap:airgap123@postgres:5432/airgap_db"
